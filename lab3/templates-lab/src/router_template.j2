hostname {{ hostname }}

interface Loopback0
 ip address {{ loopback }} 255.255.255.255

{% for intf in interfaces %}
interface {{ intf.name }}
 ip address {{ intf.ip }} {{ intf.mask }}
 no shutdown
{% endfor %}

router ospf 1
 router-id {{ loopback }}
{% for intf in interfaces %}
 network {{ intf.ip }} {{ intf.mask }} area {{ intf.area }}
{% endfor %}

