[3057.634928, "o", "\u001b(B\u001b[m"]
[3057.636631, "o", "\u001b[H"]
[3057.63707, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                     template-task8.j2                                                \u001b[1;115H"]
[3057.637503, "o", "\u001b(B\u001b[m"]
[3057.63801, "o", "\r\u001b[57d"]
[3057.638439, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[3057.638895, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[3057.639317, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[3057.63985, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[3057.64027, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[3057.640721, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[3057.641231, "o", "\u001b[2d"]
[3057.64165, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[3057.642051, "o", "\u001b[?12l\u001b[?25h"]
[3070.691414, "o", "\u001b[?25l"]
[3070.69322, "o", "\u001b[1;107H"]
[3070.693746, "o", "\u001b(B\u001b[0;7mModified"]
[3070.693994, "o", "\u001b(B\u001b[m"]
[3070.695576, "o", "\r\u001b[2d"]
[3070.695846, "o", "\u001b[36m# import Jinja2 library and PyYAML\r\u001b[3d"]
[3070.696115, "o", "\u001b[39m\u001b(B\u001b[mfrom jinja2 import Environment, FileSystemLoader\r\u001b[4d"]
[3070.696358, "o", "import yaml\r\u001b[5d"]
[3070.69663, "o", "\u001b[36m# Declare template environment\r\u001b[6d"]
[3070.696869, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader('.'))\r\u001b[7d"]
[3070.697118, "o", "def get_interface_speed(interface_name):\r\u001b[8d"]
[3070.697353, "o", "\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[9d"]
[3070.697606, "o", "network interface by looking for certain keywords in the name\r\u001b[10d"]
[3070.697838, "o", "\"\"\"\r\u001b[11d"]
[3070.69807, "o", "if 'gigabit' in interface_name.lower():\r\u001b[12d"]
[3070.698301, "o", "return 1000\r\u001b[56d"]
[3070.698564, "o", "\u001b[K\u001b[13d"]
[3070.698788, "o", "\u001b[?12l\u001b[?25h"]
[3070.699029, "o", "\u001b[?25l"]
[3070.702219, "o", "if 'fast' in interface_name.lower():\r\u001b[14d"]
[3070.702498, "o", "return 100\r\u001b[15d"]
[3070.702747, "o", "\u001b[36m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[16d"]
[3070.703015, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[17d"]
[3070.70326, "o", "# it--the template engine will execute this function when we call\r\u001b[18d"]
[3070.703535, "o", "# template.render()\r\u001b[19d"]
[3070.703782, "o", "\u001b[39m\u001b(B\u001b[mENV.filters['get_interface_speed'] = get_interface_speed\r\u001b[20d"]
[3070.704036, "o", "template = ENV.get_template(\"template-task8.j2\")\r\u001b[21d"]
[3070.704275, "o", "\u001b[36m# We load our YAML file and pass it in to the template when rendering it.\r\u001b[22d"]
[3070.704545, "o", "\u001b[39m\u001b(B\u001b[mwith open(\"data-task7.yml\") as f:\r\u001b[23d"]
[3070.704784, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[24d"]
[3070.705028, "o", "print(template.render(interface_list=interfaces))"]
