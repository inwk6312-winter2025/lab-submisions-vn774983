[1733.178869, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[1733.179417, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to load templates from the current directory\r\u001b[5d"]
[1733.179913, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[6d"]
[1733.180326, "o", "\u001b[?12l\u001b[?25h"]
[1733.180764, "o", "\u001b[?25l"]
[1733.189972, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task3.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[8d"]
[1733.190451, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the NetworkInterface class\r\u001b[9d"]
[1733.19087, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface(object):\u001b[10;5H"]
[1733.191327, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, name, description, vlan, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m):\u001b[11;9H"]
[1733.191787, "o", "self.name = name\u001b[12;9H"]
[1733.192241, "o", "self.description = description\u001b[13;9H"]
[1733.192683, "o", "self.vlan = vlan\u001b[14;9H"]
[1733.193106, "o", "self.uplink = uplink\r\u001b[16d"]
[1733.193517, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a single interface object\r\u001b[17d"]
[1733.193985, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet0/1\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Server Port\"\u001b[39m\u001b(B\u001b[m, 10)\r\u001b[19d"]
[1733.194412, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print the template for all 10 interfaces\r\u001b[20d"]
[1733.194867, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))\r\u001b[21d"]
