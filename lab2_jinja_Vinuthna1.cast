[2193.470383, "o", "\u001b[2d"]
[2193.470825, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[2193.471238, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to load templates from the current directory\r\u001b[5d"]
[2193.471716, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[6d"]
[2193.472156, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task3.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[8d"]
[2193.472583, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the NetworkInterface class\r\u001b[9d"]
[2193.472987, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface(object):\u001b[10;5H"]
[2193.473549, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, name, description, vlan, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m):\u001b[11;9H"]
[2193.47396, "o", "self.name = name\u001b[12;9H"]
[2193.474529, "o", "self.description = description\u001b[13;9H"]
[2193.474935, "o", "self.vlan = vlan\u001b[14;9H"]
[2193.475362, "o", "self.uplink = uplink\r\u001b[16d"]
[2193.475779, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a single interface object\r\u001b[17d"]
[2193.476232, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet0/1\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Server Port\"\u001b[39m\u001b(B\u001b[m, 10)\r\u001b[19d"]
[2193.476645, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print the template for all 10 interfaces\r\u001b[20d"]
[2193.477108, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))\r\u001b[2d"]
