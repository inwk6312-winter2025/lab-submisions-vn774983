[1822.415635, "o", "\u001b[2d"]
[1822.416064, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[1822.416476, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to load templates from the current directory\r\u001b[5d"]
[1822.417017, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[6d"]
[1822.417429, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task3.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[8d"]
[1822.417871, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the NetworkInterface class\r\u001b[9d"]
[1822.418292, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface(object):\u001b[10;5H"]
[1822.418742, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, name, description, vlan, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m):\u001b[11;9H"]
[1822.419152, "o", "self.name = name\u001b[12;9H"]
[1822.41962, "o", "self.description = description\u001b[13;9H"]
[1822.420087, "o", "self.vlan = vlan\u001b[14;9H"]
[1822.420516, "o", "self.uplink = uplink\r\u001b[16d"]
[1822.420934, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a single interface object\r\u001b[17d"]
[1822.421398, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet0/1\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Server Port\"\u001b[39m\u001b(B\u001b[m, 10)\r\u001b[19d"]
[1822.421821, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print the template for all 10 interfaces\r\u001b[20d"]
[1822.422266, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))\r\u001b[2d"]
