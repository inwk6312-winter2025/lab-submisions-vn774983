[3174.392162, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[3174.394062, "o", "\u001b[2d"]
[3174.394475, "o", "\u001b(B\u001b[0;1m\u001b[31m# import Jinja2 library and PyYAML\r\u001b[3d"]
[3174.394872, "o", "\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[3174.395301, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[6d"]
[3174.395786, "o", "\u001b(B\u001b[0;1m\u001b[31m# Declare template environment\r\u001b[7d"]
[3174.396184, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[8d"]
[3174.39658, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\r\u001b[9d"]
[3174.397032, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\" get_interface_speed returns the default Mbps value for a given\r\u001b[10d"]
[3174.39742, "o", "network interface by looking for certain keywords in the name\r\u001b[11d"]
[3174.397833, "o", "\"\"\"\u001b[12;9H"]
[3174.398224, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[13;17H"]
[3174.398649, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\u001b[14;9H"]
[3174.399046, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[15;17H"]
[3174.399465, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\r\u001b[16d"]
[3174.399887, "o", "\u001b(B\u001b[0;1m\u001b[31m# Filters are added to the ENV object after declaration. Note that we're\r\u001b[17d"]
[3174.40031, "o", "# actually passing in our \"get_interface_speed\" function and not running\r\u001b[18d"]
[3174.400703, "o", "# it--the template engine will execute this function when we call\r\u001b[19d"]
[3174.401183, "o", "# template.render()\r\u001b[21d"]
