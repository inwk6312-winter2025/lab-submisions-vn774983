[1658.611428, "o", "\r\u001b[2d"]
[1658.611895, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[1658.612343, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment to load templates from the current directory\r\u001b[5d"]
[1658.61277, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[56d"]
[1658.613199, "o", "\u001b[K\u001b[6d"]
[1658.61355, "o", "\u001b[?12l\u001b[?25h"]
[1658.613937, "o", "\u001b[?25l"]
[1658.622467, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task3.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[8d"]
[1658.622938, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define the NetworkInterface class\r\u001b[9d"]
[1658.62335, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface(object):\u001b[10;5H"]
[1658.623848, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, name, description, vlan, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m):\u001b[11;9H"]
[1658.624269, "o", "self.name = name\u001b[12;9H"]
[1658.624703, "o", "self.description = description\u001b[13;9H"]
[1658.625103, "o", "self.vlan = vlan\u001b[14;9H"]
[1658.625551, "o", "self.uplink = uplink\r\u001b[16d"]
[1658.625954, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a single interface object\r\u001b[17d"]
[1658.626409, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet0/1\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Server Port\"\u001b[39m\u001b(B\u001b[m, 10)\r\u001b[19d"]
[1658.626816, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print the template for all 10 interfaces\r\u001b[20d"]
[1658.627279, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))"]
