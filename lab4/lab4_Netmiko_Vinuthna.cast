[7441.611876, "o", "\u001b[2d"]
[7441.612294, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[3d"]
[7441.612688, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7441.613129, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m textfsm\r\u001b[5d"]
[7441.613545, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7441.613968, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7441.614367, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'routing_table.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7441.61479, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7441.615185, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7441.615601, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7441.615985, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7441.616416, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7441.616832, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7441.61729, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\u001b[17;5H"]
[7441.617679, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7441.618109, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[19;5H"]
[7441.618495, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[7441.618923, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[7441.619312, "o", "exit(1)\r\u001b[23d"]
[7441.619718, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load TextFSM template\r\u001b[24d"]
[7441.620061, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[25d"]
[7441.620455, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'cisco_ios_show_ip_route.textfsm'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m template_file:\u001b[26;9H"]
[7441.620898, "o", "fsm = textfsm.TextFSM(template_file)\u001b[27;5H"]
[7441.621306, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded TextFSM template: cisco_ios_show_ip_route.textfsm\"\u001b[39m\u001b(B\u001b[m)\r\u001b[28d"]
[7441.621701, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[29;5H"]
[7441.62214, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load TextFSM template: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[30;5H"]
[7441.622522, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load TextFSM template - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[31;5H"]
[7441.622966, "o", "exit(1)\r\u001b[33d"]
[7441.623377, "o", "\u001b(B\u001b[0;1m\u001b[31m# Collect routing tables\r\u001b[34d"]
[7441.623807, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[35;5H"]
[7441.62421, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[36d\b"]
[7441.62463, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[37;9H"]
[7441.625017, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device_name} ({device_info['ip']})...\"\u001b[39m\u001b(B\u001b[m)\u001b[38;9H"]
[7441.625439, "o", "connection = ConnectHandler(\u001b[39;13H"]
[7441.625845, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[40;13H"]
[7441.626233, "o", "host=device_info_episode\u001b[41;13H"]
[7441.626655, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[42;13H"]
[7441.626921, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[43;9H"]
[7441.627177, "o", ")\u001b[44d\b"]
[7441.627457, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[7441.628116, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[47;8H"]
[7441.628381, "o", "\u001b(B\u001b[0;1m\u001b[31m # Get routing table\u001b[48;9H"]
[7441.628634, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Collecting routing table from {device_name}...\"\u001b[39m\u001b(B\u001b[m)\u001b[49;9H"]
[7441.628919, "o", "output = connection.send_command(\u001b(B\u001b[0;1m\u001b[32m'show ip route'\u001b[39m\u001b(B\u001b[m)\u001b[50;9H"]
[7441.629172, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[51;9H"]
[7441.629483, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[53;8H"]
[7441.629731, "o", "\u001b(B\u001b[0;1m\u001b[31m # Parse with TextFSM\u001b[54;9H"]
[7441.629998, "o", "\u001b[39m\u001b(B\u001b[mfsm.Reset()\u001b[55;9H"]
[7441.630241, "o", "parsed_output = fsm.ParseText(output)\r\u001b[2d"]
