[4386.715324, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[12d\b"]
[4386.71577, "o", "net_connect = Netmiko(**device)\r\u001b[13d"]
[4386.716191, "o", "output = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[14d"]
[4386.71666, "o", "net_connect.disconnect()\r\u001b[16d"]
