[7323.252403, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m textfsm\r\u001b[5d"]
[7323.252978, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7323.254432, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7323.255445, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'routing_table.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,"]
[7323.256134, "o", "\u001b[9;21H"]
[7323.256882, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7323.257321, "o", "\u001b[?12l\u001b[?25h"]
[7323.257801, "o", "\u001b[?25l"]
[7323.276265, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7323.276904, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7323.277392, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7323.277837, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7323.27826, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7323.278735, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\u001b[17;5H"]
[7323.279193, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7323.279631, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[19;5H"]
[7323.280083, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[7323.280503, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[7323.280936, "o", "exit(1)\r\u001b[23d"]
[7323.28139, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load TextFSM template\r\u001b[24d"]
[7323.281836, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[25d"]
[7323.282265, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'cisco_ios_show_ip_route.textfsm'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m template_file:\u001b[26;9H"]
[7323.282762, "o", "fsm = textfsm.TextFSM(template_file)\u001b[27;5H"]
[7323.283184, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded TextFSM template: cisco_ios_show_ip_route.textfsm\"\u001b[39m\u001b(B\u001b[m)\r\u001b[28d"]
[7323.283639, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[29;5H"]
[7323.284066, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load TextFSM template: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[30d"]
[7323.284488, "o", "\u001b[?12l\u001b[?25h"]
[7323.284907, "o", "\u001b[?25l"]
[7323.354553, "o", "\u001b[2;56r\u001b[56;1H"]
[7323.355455, "o", "\u001b[16S\u001b[1;58r\u001b[14;5H"]
[7323.355896, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load TextFSM template - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[15;5H"]
[7323.356367, "o", "exit(1)\r\u001b[17d"]
[7323.356818, "o", "\u001b(B\u001b[0;1m\u001b[31m# Collect routing tables\r\u001b[18d"]
[7323.357252, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[19;5H"]
[7323.357672, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[20d\b"]
[7323.35813, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[21;9H"]
[7323.358558, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device_name} ({device_info['ip']})...\"\u001b[39m\u001b(B\u001b[m)\u001b[22;9H"]
[7323.359016, "o", "connection = ConnectHandler(\u001b[23;13H"]
[7323.359377, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[24;13H"]
[7323.359747, "o", "host=device_info_episode\u001b[25;13H"]
[7323.360196, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[26;13H"]
[7323.360655, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[27;9H"]
[7323.361073, "o", ")\u001b[28d\b"]
[7323.36154, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[29;9H"]
[7323.361966, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[31;8H"]
[7323.362418, "o", "\u001b(B\u001b[0;1m\u001b[31m # Get routing table\u001b[32;9H"]
[7323.362839, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Collecting routing table from {device_name}...\"\u001b[39m\u001b(B\u001b[m)\u001b[33;9H"]
[7323.363256, "o", "output = connection.send_command(\u001b(B\u001b[0;1m\u001b[32m'show ip route'\u001b[39m\u001b(B\u001b[m)\u001b[34;9H"]
[7323.363636, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[35;9H"]
[7323.364074, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[37;8H"]
[7323.364495, "o", "\u001b(B\u001b[0;1m\u001b[31m # Parse with TextFSM\u001b[38;9H"]
[7323.364928, "o", "\u001b[39m\u001b(B\u001b[mfsm.Reset()\u001b[39;9H"]
[7323.365354, "o", "parsed_output = fsm.ParseText(output)\u001b[41;8H"]
[7323.365835, "o", "\u001b(B\u001b[0;1m\u001b[31m # Print parsed routing table\u001b[42;9H"]
[7323.366248, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"\\nRouting Table for {device_name}:\"\u001b[39m\u001b(B\u001b[m)\u001b[43;9H"]
[7323.366694, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"{' | '.join(fsm.header)}\"\u001b[39m\u001b(B\u001b[m)\u001b[44;9H"]
[7323.367109, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m row \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m parsed_output:\u001b[45;13H"]
[7323.367563, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"{' | '.join(row)}\"\u001b[39m\u001b(B\u001b[m)\u001b[46;9H"]
[7323.367995, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Parsed routing table for {device_name}: {parsed_output}\"\u001b[39m\u001b(B\u001b[m)\u001b[48;8H"]
[7323.368476, "o", "\u001b(B\u001b[0;1m\u001b[31m # Disconnect\u001b[49;9H"]
[7323.36889, "o", "\u001b[39m\u001b(B\u001b[mconnection.disconnect()\u001b[50;9H"]
[7323.369212, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Disconnected from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[51;9H"]
[7323.36952, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Disconnected from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[53;5H"]
