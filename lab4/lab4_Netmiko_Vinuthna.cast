[8110.16419, "o", "hostname {{ name }}\r\u001b[5d"]
[8110.16484, "o", "{% if loopback %}\r\u001b[6d"]
[8110.165291, "o", "interface {{ loopback.keys() | first }}\u001b[7;3H"]
[8110.165762, "o", "ip address {{ loopback.values() | first.ip_address }} {{ loopback.values() | first.mask | ip_mask }}\r\u001b[8d"]
[8110.166187, "o", "{% endif %}\r\u001b[10d"]
[8110.166642, "o", "{% for interface_name, interface_data in interfaces.items() %}\r\u001b[11d"]
