[4423.116289, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                         New Buffer                                                   \u001b[56;1H\u001b(B\u001b[m\u001b[K\u001b[1;115H"]
[4423.116493, "o", "\u001b[56;34H\u001b(B\u001b[0;7m[ Welcome to nano.  For basic help, type Ctrl+G. ]"]
[4423.117447, "o", "\u001b(B\u001b[m\r\u001b[57d"]
[4423.118115, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[4423.118671, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;18H\u001b(B\u001b[0;7mR\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d\u001b[1;107H"]
[4423.119442, "o", "\u001b[39;49m\u001b(B\u001b[0;7mModified\u001b(B\u001b[m"]
[4423.119823, "o", "\r\u001b[2d"]
[4423.120087, "o", "etmiko import Netmiko\r\u001b[4d"]
[4423.120343, "o", "\u001b[?12l\u001b[?25h\u001b[?25l"]
[4423.128629, "o", "# Define all 3 routers\r\u001b[5d"]
[4423.12902, "o", "devices = [\u001b[6;5H"]
[4423.129452, "o", "{\u001b[7;9H"]
[4423.129858, "o", "\"device_type\": \"cisco_ios\",\u001b[8;9H"]
[4423.130287, "o", "\"ip\": \"192.168.1.101\",\u001b[9;9H"]
[4423.130671, "o", "\"username\": \"student\",\u001b[10;9H"]
[4423.131088, "o", "\"password\": \"Meilab123\",\u001b[11;9H"]
[4423.131495, "o", "\"port\": \"22\"\u001b[12;5H"]
[4423.131915, "o", "},\u001b[13d\b\b"]
[4423.132334, "o", "{\u001b[14;9H"]
[4423.132759, "o", "\"device_type\": \"cisco_ios\",\u001b[15;9H"]
[4423.133162, "o", "\"ip\": \"192.168.1.102\",\u001b[16;9H"]
[4423.133607, "o", "\"username\": \"student\",\u001b[17;9H"]
[4423.133994, "o", "\"password\": \"Meilab123\",\u001b[18;9H"]
[4423.134423, "o", "\"port\": \"22\"\u001b[19;5H"]
[4423.134822, "o", "},\u001b[20d\b\b"]
[4423.135265, "o", "{\u001b[21;9H"]
[4423.135658, "o", "\"device_type\": \"cisco_ios\",\u001b[22;9H"]
[4423.136091, "o", "\"ip\": \"192.168.1.103\",\u001b[23;9H"]
[4423.136481, "o", "\"username\": \"student\",\u001b[24;9H"]
[4423.136904, "o", "\"password\": \"Meilab123\",\u001b[25;9H"]
[4423.137306, "o", "\"port\": \"22\"\u001b[26;5H"]
[4423.137734, "o", "}\r\u001b[27d"]
[4423.138131, "o", "]\u001b[29d\b"]
[4423.138568, "o", "# Loop through each device\r\u001b[30d"]
[4423.138964, "o", "for device in devices:\u001b[31;5H"]
[4423.139377, "o", "print(f\"Connecting to {device['ip']}...\\n\")\u001b[32;5H"]
[4423.139737, "o", "net_connect = Netmiko(**device)\u001b[34;5H"]
[4423.140165, "o", "# Get parsed output of \"show ip interface brief\"\u001b[35;5H"]
[4423.140572, "o", "output = net_connect.send_command(\"show ip interface brief\", use_textfsm=True)\u001b[36;5H"]
[4423.141008, "o", "net_connect.disconnect()\u001b[38;5H"]
[4423.141445, "o", "# Print interface names\u001b[39;5H"]
[4423.141722, "o", "print(f\"Interfaces on {device['ip']}:\")\u001b[40;5H"]
[4423.141987, "o", "for interface in output:\u001b[41;9H"]
[4423.142575, "o", "print(f\" - {interface.get('interface', 'Unknown')}\")\u001b[42;5H"]
[4423.142852, "o", "print(\"=\" * 80)\r\u001b[56d"]
[4423.143149, "o", "\u001b[K\u001b[43d"]
[4423.143394, "o", "\u001b[?12l\u001b[?25h"]
