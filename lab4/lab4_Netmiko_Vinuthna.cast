[4386.710452, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[4386.711803, "o", "\u001b[2d"]
[4386.712237, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[4d"]
[4386.712649, "o", "device = {\u001b[5;5H"]
[4386.713096, "o", "\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m,\u001b[6;5H"]
[4386.71356, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m,\u001b[7;5H"]
[4386.714046, "o", "\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m,\u001b[8;5H"]
[4386.714467, "o", "\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m,\u001b[9;5H"]
