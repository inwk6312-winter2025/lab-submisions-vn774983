[8135.807183, "o", "\u001b[1K "]
[8135.807657, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[K\u001b[9;12H"]
[8135.80808, "o", "\u001b[1K "]
