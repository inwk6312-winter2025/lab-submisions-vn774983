[4695.945281, "o", "cat cisco_ios_show_ip_interface_brief.textfsm\r\n"]
[4695.947854, "o", "Value INTERFACE (\\S+)"]
[4695.948315, "o", "\r\n"]
[4695.948748, "o", "Value IP_ADDRESS (\\S+)"]
[4695.949138, "o", "\r\n"]
[4695.949623, "o", "Value STATUS (up|down|administratively down|deleted)"]
[4695.950006, "o", "\r\n"]
[4695.950409, "o", "Value PROTO (up|down)"]
[4695.950758, "o", "\r\n"]
[4695.951168, "o", "\r\n"]
[4695.951553, "o", "Start"]
[4695.951955, "o", "\r\n"]
[4695.952379, "o", "  ^${INTERFACE}\\s+${IP_ADDRESS}\\s+\\w+\\s+\\w+\\s+${STATUS}\\s+${PROTO} -> Record"]
[4695.95278, "o", "\r\n"]
[4695.953156, "o", "  # Capture time-stamp if vty line has command time-stamping turned on"]
[4695.953623, "o", "\r\n"]
[4695.953999, "o", "  ^Load\\s+for\\s+"]
[4695.954393, "o", "\r\n"]
[4695.95483, "o", "  ^Time\\s+source\\s+is"]
[4695.955216, "o", "\r\n"]
