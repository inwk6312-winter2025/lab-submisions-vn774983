[7249.279347, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[7249.282035, "o", "\u001b[2d"]
[7249.282462, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[3d"]
[7249.282871, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7249.283301, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m textfsm\r\u001b[5d"]
[7249.283725, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7249.284124, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7249.284506, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'routing_table.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7249.284938, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7249.285341, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7249.285763, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7249.286153, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7249.286591, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7249.286979, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7249.287392, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\r\u001b[17d"]
[7249.287839, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[18;5H"]
[7249.288235, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[19;5H"]
[7249.288653, "o", "exit(1)\r\u001b[21d"]
[7249.28906, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load TextFSM template (assumes Cisco IOS 'show ip route' template)\r\u001b[22d"]
[7249.289508, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'cisco_ios_show_ip_route.textfsm'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m template_file:\u001b[23;5H"]
[7249.289905, "o", "fsm = textfsm.TextFSM(template_file)\r\u001b[25d"]
[7249.290326, "o", "\u001b(B\u001b[0;1m\u001b[31m# Collect routing tables\r\u001b[26d"]
[7249.290725, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[27;5H"]
[7249.291144, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[28d\b"]
[7249.291532, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[29;9H"]
[7249.291941, "o", "\u001b[39m\u001b(B\u001b[mconnection = ConnectHandler(\u001b[30;13H"]
[7249.292334, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[31;13H"]
[7249.292746, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[32;13H"]
[7249.293131, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[33;13H"]
[7249.293555, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[34;9H"]
[7249.293944, "o", ")\u001b[35d\b"]
[7249.294372, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[37;8H"]
[7249.294758, "o", "\u001b(B\u001b[0;1m\u001b[31m # Get routing table\u001b[38;9H"]
[7249.295143, "o", "\u001b[39m\u001b(B\u001b[moutput = connection.send_command(\u001b(B\u001b[0;1m\u001b[32m'show ip route'\u001b[39m\u001b(B\u001b[m)\u001b[39;9H"]
[7249.295593, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[41;8H"]
[7249.296016, "o", "\u001b(B\u001b[0;1m\u001b[31m # Parse with TextFSM\u001b[42;9H"]
[7249.296402, "o", "\u001b[39m\u001b(B\u001b[mfsm.Reset()\u001b[43;9H"]
[7249.29678, "o", "parsed_output = fsm.ParseText(output)\u001b[45;8H"]
[7249.297209, "o", "\u001b(B\u001b[0;1m\u001b[31m # Print parsed routing table\u001b[46;9H"]
