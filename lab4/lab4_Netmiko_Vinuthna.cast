[7782.325721, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[7782.328428, "o", "\u001b[2d"]
[7782.328852, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[3d"]
[7782.329274, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7782.329732, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m jinja2\r\u001b[5d"]
[7782.33016, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7782.330557, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7782.330989, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'network_config.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7782.331405, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7782.331798, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7782.332233, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7782.332627, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7782.333061, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices2.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7782.333522, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7782.333926, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\u001b[17;5H"]
[7782.334331, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices2.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7782.33477, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[19;5H"]
[7782.335169, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[7782.335606, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices2.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[7782.336025, "o", "exit(1)\r\u001b[23d"]
[7782.336422, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[24d"]
[7782.336866, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[25d"]
[7782.337284, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[26d"]
[7782.337724, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded JINJA template: config_template.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[28d"]
[7782.338133, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure each device\r\u001b[29d"]
[7782.338565, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices2'\u001b[39m\u001b(B\u001b[m].items():\u001b[30;5H"]
[7782.338978, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[31d\b"]
[7782.339399, "o", "\u001b(B\u001b[0;1m\u001b[31m # Render configuration using Jinja2\u001b[32;9H"]
[7782.339791, "o", "\u001b[39m\u001b(B\u001b[mconfig = template.render(device=device_info)\u001b[33;9H"]
[7782.340212, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[34;9H"]
[7782.340657, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[36;8H"]
[7782.341072, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[37;9H"]
[7782.341561, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device_name} ({device_info['ip']})...\"\u001b[39m\u001b(B\u001b[m)\u001b[38;9H"]
[7782.342013, "o", "connection = ConnectHandler(\u001b[39;13H"]
[7782.34242, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[40;13H"]
[7782.342825, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[41;13H"]
[7782.343277, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[42;13H"]
[7782.343562, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[43;9H"]
[7782.344064, "o", ")\u001b[44d\b"]
[7782.344351, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[7782.344657, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[47;8H"]
[7782.344926, "o", "\u001b(B\u001b[0;1m\u001b[31m # Send configuration commands\u001b[48;9H"]
[7782.345246, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Pushing configuration to {device_name}...\"\u001b[39m\u001b(B\u001b[m)\u001b[49;9H"]
[7782.345517, "o", "connection.send_config_set(config.splitlines())\u001b[50;9H"]
[7782.346328, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration pushed to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[51;9H"]
[7782.346624, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration pushed to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[53;8H"]
