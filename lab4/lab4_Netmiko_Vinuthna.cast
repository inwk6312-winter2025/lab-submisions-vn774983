[8135.820578, "o", "\u001b[32m'password'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'your_password'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[31m # <--- REPLACE WITH YOUR PASSWORD\u001b[31;17H"]
