[5114.089438, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m,\u001b[8;5H"]
[5114.089839, "o", "\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m,\u001b[9;5H"]
[5114.090274, "o", "\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m,\u001b[10;5H"]
[5114.090618, "o", "\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\"\u001b[39m\u001b(B\u001b[m,\r\u001b[11d"]
[5114.091014, "o", "}]\r\u001b[13d"]
[5114.091341, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loopback interface details\r\u001b[14d"]
[5114.091695, "o", "\u001b[39m\u001b(B\u001b[mloopback_interface = \u001b(B\u001b[0;1m\u001b[32m\"Loopback1\"\r\u001b[15d"]
