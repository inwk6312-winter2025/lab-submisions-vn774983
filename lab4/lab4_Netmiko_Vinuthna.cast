[7076.992609, "o", "\u001b(B\u001b[0;7mM-P\u001b(B\u001b[m Prepend\u001b[58;88H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Files\r\u001b[56d\u001b(B\u001b[0;7mFile Name to Write: collect_routing_tables.py\r"]
