[7530.184635, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[47;8H"]
[7530.184916, "o", "\u001b(B\u001b[0;1m\u001b[31m # Send configuration commands\u001b[48;9H"]
[7530.185316, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Pushing configuration to {device_name}...\"\u001b[39m\u001b(B\u001b[m)\u001b[49;9H"]
