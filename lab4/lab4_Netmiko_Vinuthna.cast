[7073.067871, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[7073.068303, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[7073.068699, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[7073.06913, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
