[7227.806196, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7227.806584, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7227.806945, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'network_config.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7227.8073, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7227.807624, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7227.807952, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7227.808269, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7227.808647, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7227.80906, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7227.809436, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\u001b[17;5H"]
[7227.809824, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7227.810208, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[19;5H"]
[7227.810645, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[7227.811044, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[7227.811464, "o", "exit(1)\r\u001b[23d"]
[7227.811863, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[24d"]
[7227.812256, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[25d"]
[7227.81269, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[26d"]
