[8159.806044, "o", " # textfsm_templates_path = './ntc-templates/templates'\u001b[6;9H"]
[8159.806456, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m os.path.exists(textfsm_templates_path):\u001b[7;13H"]
[8159.806892, "o", "logger.critical(f\u001b(B\u001b[0;1m\u001b[32m\"TextFSM templates path not found: {textfsm_templates_path}. Please update 'textfsm_te\u001b[39m\u001b(B\u001b[0;7m>\u001b[8;13H"]
[8159.807336, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[10;9H"]
[8159.807772, "o", "\u001b[39m\u001b(B\u001b[mall_routing_tables = {}\u001b[12;9H"]
[8159.808172, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_data \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[13;13H"]
[8159.808631, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'router'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m device_data.get(\u001b(B\u001b[0;1m\u001b[32m'groups'\u001b[39m\u001b(B\u001b[m, []):\u001b(B\u001b[0;1m\u001b[31m # Only process devices tagged as 'router'\u001b[14;17H"]
[8159.809047, "o", "\u001b[39m\u001b(B\u001b[mlogger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Collecting routing table from: {device_data['name']} ({device_data['host']})\"\u001b[39m\u001b(B\u001b[m)\u001b[16;17H"]
