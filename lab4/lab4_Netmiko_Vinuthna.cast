[7530.167499, "o", "\u001b[2d"]
[7530.167958, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[3d"]
[7530.16837, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7530.168854, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m jinja2\r\u001b[5d"]
[7530.16933, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7530.16976, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7530.170165, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'network_config.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7530.17066, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7530.171054, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7530.17153, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7530.171934, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7530.172412, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7530.172819, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7530.173319, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\u001b[17;5H"]
[7530.173731, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[18d"]
[7530.174214, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[19;5H"]
[7530.174638, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[7530.175118, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[7530.175519, "o", "exit(1)\r\u001b[23d"]
[7530.176, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[24d"]
[7530.176405, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[25d"]
[7530.176885, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[26d"]
[7530.177387, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded JINJA template: config_template.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[28d"]
[7530.177804, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure each device\r\u001b[29d"]
[7530.178213, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[30;5H"]
[7530.178695, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[31d\b"]
[7530.179096, "o", "\u001b(B\u001b[0;1m\u001b[31m # Render configuration using Jinja2\u001b[32;9H"]
[7530.179579, "o", "\u001b[39m\u001b(B\u001b[mconfig = template.render(device=device_info)\u001b[33;9H"]
[7530.180054, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[34;9H"]
[7530.18048, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[36;8H"]
[7530.180982, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[37;9H"]
[7530.181433, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device_name} ({device_info['ip']})...\"\u001b[39m\u001b(B\u001b[m)\u001b[38;9H"]
[7530.181932, "o", "connection = ConnectHandler(\u001b[39;13H"]
[7530.182363, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[40;13H"]
[7530.182782, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[41;13H"]
[7530.183146, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[42;13H"]
[7530.183707, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[43;9H"]
[7530.183995, "o", ")\u001b[44d\b"]
