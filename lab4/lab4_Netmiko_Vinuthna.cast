[7073.070015, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[7073.070522, "o", "\u001b[2d"]
[7073.070872, "o", "\u001b[39;49m\u001b(B\u001b[m"]
