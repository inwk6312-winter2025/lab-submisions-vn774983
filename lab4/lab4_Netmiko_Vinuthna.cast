[7075.499329, "o", "\r\u001b[2d"]
[7075.500352, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[56d"]
[7075.500749, "o", "\u001b[K\u001b[3d"]
[7075.501165, "o", "\u001b[?12l\u001b[?25h"]
[7075.501579, "o", "\u001b[?25l"]
[7075.557486, "o", "\u001b[A"]
[7075.558293, "o", "\u001b[K\u001b[3d"]
[7075.558751, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[4d"]
[7075.559269, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'routing_table.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[5;21H"]
[7075.55968, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[6d"]
[7075.560057, "o", "logger = logging.getLogger(__name__)\r\u001b[8d"]
[7075.560452, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[9d"]
[7075.560894, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[10d"]
[7075.561344, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[11;9H"]
[7075.561766, "o", "config_data = yaml.safe_load(file)\u001b[12;5H"]
[7075.562184, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\r\u001b[13d"]
[7075.562619, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[14;5H"]
[7075.563018, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[15;5H"]
[7075.563443, "o", "exit(1)\r\u001b[17d"]
[7075.563832, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load TextFSM template (assumes Cisco IOS 'show ip route' template)\r\u001b[18d"]
[7075.564276, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'cisco_ios_show_ip_route.textfsm'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m template_file:\u001b[19;5H"]
[7075.564677, "o", "fsm = textfsm.TextFSM(template_file)\r\u001b[21d"]
[7075.565089, "o", "\u001b(B\u001b[0;1m\u001b[31m# Collect routing tables\r\u001b[22d"]
[7075.565507, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[23;5H"]
[7075.565909, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[24d\b"]
[7075.566285, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[25;9H"]
[7075.566668, "o", "\u001b[39m\u001b(B\u001b[mconnection = ConnectHandler(\u001b[26;13H"]
[7075.567054, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[27;13H"]
[7075.567472, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[28;13H"]
[7075.567858, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[29;13H"]
[7075.568278, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[30;9H"]
[7075.568698, "o", ")\u001b[31d\b"]
[7075.569176, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[33;8H"]
[7075.569589, "o", "\u001b(B\u001b[0;1m\u001b[31m # Get routing table\u001b[34;9H"]
[7075.570005, "o", "\u001b[39m\u001b(B\u001b[moutput = connection.send_command(\u001b(B\u001b[0;1m\u001b[32m'show ip route'\u001b[39m\u001b(B\u001b[m)\u001b[35;9H"]
[7075.570432, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Collected routing table from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[37;8H"]
[7075.570825, "o", "\u001b(B\u001b[0;1m\u001b[31m # Parse with TextFSM\u001b[38;9H"]
[7075.571203, "o", "\u001b[39m\u001b(B\u001b[mfsm.Reset()\u001b[39;9H"]
[7075.571618, "o", "parsed_output = fsm.ParseText(output)\u001b[41;8H"]
[7075.572003, "o", "\u001b(B\u001b[0;1m\u001b[31m # Print parsed routing table\u001b[42;9H"]
[7075.572304, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"\\nRouting Table for {device_name}:\"\u001b[39m\u001b(B\u001b[m)\u001b[43;9H"]
[7075.572784, "o", "print(fsm.header)\u001b[44;9H"]
[7075.573052, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m row \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m parsed_output:\u001b[45;13H"]
[7075.573319, "o", "print(row)\u001b[47;8H"]
[7075.573589, "o", "\u001b(B\u001b[0;1m\u001b[31m # Log parsed output\u001b[48;9H"]
[7075.573861, "o", "\u001b[39m\u001b(B\u001b[mlogger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Parsed routing table for {device_name}: {parsed_output}\"\u001b[39m\u001b(B\u001b[m)\u001b[50;8H"]
[7075.574131, "o", "\u001b(B\u001b[0;1m\u001b[31m # Disconnect\u001b[51;9H"]
[7075.574379, "o", "\u001b[39m\u001b(B\u001b[mconnection.disconnect()\u001b[52;9H"]
[7075.575257, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Disconnected from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[54;5H"]
[7075.575527, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[55;9H"]
[7075.575804, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to collect routing table from {device_name}: {str(e)}\"\u001b[39m\u001b(B\u001b[m)"]
[7075.576045, "o", "\u001b[?12l\u001b[?25h"]
[7076.671412, "o", "\u001b[?25l\r\u001b[56d"]
[7076.672306, "o", "\u001b(B\u001b[0;7mSave modified buffer?                                                                                               \u001b[57;1H Y\u001b(B\u001b[m Yes\u001b[K\r\u001b[58d\u001b(B\u001b[0;7m N\u001b(B\u001b[m No  \u001b[58;18H\u001b(B\u001b[0;7mC\u001b(B\u001b[m Cancel\u001b[K\u001b[56;23H\u001b[?12l\u001b[?25h"]
