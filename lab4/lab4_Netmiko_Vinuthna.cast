[8135.656733, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[6d"]
[8135.657818, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m os\r\u001b[8d"]
[8135.658298, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create a logs directory if it doesn't exist\r\u001b[9d"]
[8135.658706, "o", "\u001b[39m\u001b(B\u001b[mlog_dir = \u001b(B\u001b[0;1m\u001b[32m'logs'\r\u001b[10d"]
[8135.659117, "o", "\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m os.path.exists(log_dir):\u001b[11;5H"]
[8135.659557, "o", "os.makedirs(log_dir)\r\u001b[13d"]
[8135.659962, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging using the Logger class\r\u001b[14d"]
[8135.660413, "o", "\u001b[39m\u001b(B\u001b[mlogger = logging.getLogger(__name__)\r\u001b[15d"]
[8135.660811, "o", "logger.setLevel(logging.DEBUG)\u001b(B\u001b[0;1m\u001b[31m # Set to DEBUG to capture all levels\r\u001b[17d"]
[8135.661255, "o", "# Create file handler which logs even debug messages\r\u001b[18d"]
[8135.661652, "o", "\u001b[39m\u001b(B\u001b[mfile_handler = logging.FileHandler(os.path.join(log_dir, \u001b(B\u001b[0;1m\u001b[32m'network_automation.log'\u001b[39m\u001b(B\u001b[m))\r\u001b[19d"]
[8135.662081, "o", "file_handler.setLevel(logging.DEBUG)\r\u001b[21d"]
[8135.66247, "o", "\u001b(B\u001b[0;1m\u001b[31m# Create console handler with a higher log level\r\u001b[22d"]
[8135.6629, "o", "\u001b[39m\u001b(B\u001b[mconsole_handler = logging.StreamHandler()\r\u001b[23d"]
[8135.663276, "o", "console_handler.setLevel(logging.INFO)\r\u001b[24d"]
