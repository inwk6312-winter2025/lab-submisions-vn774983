[4978.890323, "o", "\u001b(B\u001b[m"]
[4978.894983, "o", "\r\u001b[2d"]
[4978.895367, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[3d"]
[4978.895655, "o", "devices = [{\u001b(B\u001b[0;1m\u001b[32m\"device_type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"cisco_ios\"\u001b[39m\u001b(B\u001b[m,\u001b[4;5H"]
[4978.895964, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"192.168.1.101\"\u001b[39m\u001b(B\u001b[m,\u001b[5;5H"]
[4978.896255, "o", "\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"student\"\u001b[39m\u001b(B\u001b[m,\u001b[6;5H"]
[4978.896527, "o", "\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Meilab123\"\u001b[39m\u001b(B\u001b[m,\u001b[7;5H"]
[4978.896793, "o", "\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"22\"\u001b[39m\u001b(B\u001b[m,}]\r\u001b[8d"]
[4978.897084, "o", "description = \u001b(B\u001b[0;1m\u001b[32m'Description set with Netmiko'\r\u001b[9d"]
[4978.897392, "o", "\u001b[39m\u001b(B\u001b[mdescription_config = [\u001b(B\u001b[0;1m\u001b[32m\"interface GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m,f\u001b(B\u001b[0;1m\u001b[32m\"description {description}\"\u001b[39m\u001b(B\u001b[m]\r\u001b[10d"]
[4978.897663, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[11;5H"]
[4978.897924, "o", "net_connect = Netmiko(**device)\u001b[12;5H"]
[4978.898199, "o", "output = net_connect.send_config_set(description_config)\u001b[13;5H"]
[4978.898453, "o", "print(output)\u001b[14;5H"]
[4978.898733, "o", "net_connect.disconnect()\r\u001b[56d"]
[4978.898978, "o", "\u001b[K\u001b[14;29H"]
