[7733.314912, "o", "\u001b[?25l"]
[7733.390724, "o", "\u001b[2d"]
[7733.391707, "o", "    \u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices2.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[3;8H"]
[7733.392155, "o", "\u001b[1K "]
[7733.392622, "o", "config_data = yaml.safe_load(file)\r\u001b[4d"]
[7733.39302, "o", "    logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\r\u001b[5d"]
[7733.39351, "o", "    print(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded devices2.yaml\"\u001b[39m\u001b(B\u001b[m)\r\u001b[6d"]
[7733.393936, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[7;5H"]
[7733.394394, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[8;5H"]
[7733.394812, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Error: Failed to load devices2.yaml - {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[9;5H"]
[7733.39526, "o", "exit(1)\r\u001b[11d"]
[7733.395671, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[12d"]
[7733.396129, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[13d"]
[7733.396556, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[14d"]
[7733.397021, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded JINJA template: config_template.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[16d"]
[7733.397454, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure each device\r\u001b[17d"]
[7733.397935, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices2'\u001b[39m\u001b(B\u001b[m].items():\u001b[18;5H"]
[7733.398351, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[19d\b"]
[7733.398791, "o", "\u001b(B\u001b[0;1m\u001b[31m # Render configuration using Jinja2\u001b[20;9H"]
[7733.399212, "o", "\u001b[39m\u001b(B\u001b[mconfig = template.render(device=device_info)\u001b[21;9H"]
[7733.399674, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[22;9H"]
[7733.40011, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[24;8H"]
[7733.400553, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[25;9H"]
[7733.400913, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device_name} ({device_info['ip']})...\"\u001b[39m\u001b(B\u001b[m)\u001b[26;9H"]
