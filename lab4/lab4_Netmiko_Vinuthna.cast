[7159.980561, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                    configura_devices.py                                              \u001b[1;115H"]
[7159.980972, "o", "\u001b(B\u001b[m"]
[7159.981657, "o", "\r\u001b[57d"]
[7159.982166, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[7159.98261, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[7159.983079, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[7159.9835, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[7159.983969, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[7159.984396, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[7159.986886, "o", "\u001b[2d"]
[7159.987363, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[3d"]
[7159.987835, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7159.988263, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m jinja2\r\u001b[5d"]
[7159.988722, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7159.989169, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7159.989666, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'network_config.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7159.990106, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7159.990519, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7159.990979, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7159.991445, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7159.991883, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7159.99235, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7159.992779, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\r\u001b[17d"]
[7159.993268, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[18;5H"]
[7159.993717, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[19;5H"]
[7159.994201, "o", "exit(1)\r\u001b[21d"]
[7159.994636, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[22d"]
[7159.995092, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[23d"]
[7159.995626, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[25d"]
[7159.9961, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure each device\r\u001b[26d"]
[7159.99655, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[27;5H"]
[7159.996987, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[28d\b"]
[7159.997472, "o", "\u001b(B\u001b[0;1m\u001b[31m # Render configuration using Jinja2\u001b[29;9H"]
[7159.997876, "o", "\u001b[39m\u001b(B\u001b[mconfig = template.render(device=device_info)\u001b[30;9H"]
[7159.998325, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[32;8H"]
[7159.998735, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[33;9H"]
[7159.99916, "o", "\u001b[39m\u001b(B\u001b[mconnection = ConnectHandler(\u001b[34;13H"]
[7159.999591, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[35;13H"]
[7160.000024, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[36;13H"]
[7160.000489, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[37;13H"]
[7160.000916, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[38;9H"]
[7160.001372, "o", ")\u001b[39d\b"]
[7160.001808, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[41;8H"]
[7160.002332, "o", "\u001b(B\u001b[0;1m\u001b[31m # Send configuration commands\u001b[42;9H"]
[7160.002643, "o", "\u001b[39m\u001b(B\u001b[mconnection.send_config_set(config.splitlines())\u001b[43;9H"]
[7160.002953, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration pushed to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[45;8H"]
[7160.003607, "o", "\u001b(B\u001b[0;1m\u001b[31m # Save configuration\u001b[46;9H"]
[7160.00393, "o", "\u001b[39m\u001b(B\u001b[mconnection.send_command(\u001b(B\u001b[0;1m\u001b[32m'write memory'\u001b[39m\u001b(B\u001b[m)\u001b[47;9H"]
[7160.004274, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration saved on {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[49;8H"]
[7160.004579, "o", "\u001b(B\u001b[0;1m\u001b[31m # Disconnect\u001b[50;9H"]
[7160.004909, "o", "\u001b[39m\u001b(B\u001b[mconnection.disconnect()\u001b[51;9H"]
[7160.005218, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Disconnected from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[53;5H"]
[7160.005568, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[54;9H"]
[7160.005858, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to configure {device_name}: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[2d"]
