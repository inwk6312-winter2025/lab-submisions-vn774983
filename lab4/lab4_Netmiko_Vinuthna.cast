[8159.814068, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[26d"]
[8159.814489, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m ConnectHandler(**netmiko_device) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m net_connect:\u001b[27;25H"]
[8159.814925, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Successfully connected to {device_data['name']}.\"\u001b[39m\u001b(B\u001b[m)\u001b[28;24H"]
