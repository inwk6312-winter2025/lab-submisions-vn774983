[8159.811179, "o", "\u001b[32m'password'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'your_password'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[31m # <--- REPLACE WITH YOUR PASSWORD\u001b[21;21H"]
[8159.811614, "o", "\u001b[32m'secret'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'your_secret'\u001b[39m\u001b(B\u001b[m,     \u001b(B\u001b[0;1m\u001b[31m # <--- REPLACE WITH YOUR ENABLE SECRET (if applicable)\u001b[22;21H"]
