[7043.041019, "o", "\u001b[?12l\u001b[?25h"]
[7044.984003, "o", "\u001b[?25l"]
[7044.985299, "o", "\u001b[1;107H"]
[7044.987048, "o", "\u001b(B\u001b[0;7mModified\u001b(B\u001b[m\r\u001b[2d"]
[7044.987907, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m ConnectHandler\r\u001b[56d"]
[7044.98834, "o", "\u001b[K\u001b[3d"]
[7044.988713, "o", "\u001b[?12l\u001b[?25h"]
[7044.989116, "o", "\u001b[?25l"]
[7045.036364, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[4d"]
[7045.037356, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m jinja2\r\u001b[5d"]
[7045.037642, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[7d"]
[7045.037909, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[8d"]
[7045.038176, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(filename=\u001b(B\u001b[0;1m\u001b[32m'network_config.log'\u001b[39m\u001b(B\u001b[m, level=logging.INFO,\u001b[9;21H"]
[7045.038543, "o", "format=\u001b(B\u001b[0;1m\u001b[32m'%(asctime)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[7045.038807, "o", "logger = logging.getLogger(__name__)\r\u001b[12d"]
[7045.040128, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load YAML file\r\u001b[13d"]
[7045.040545, "o", "\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[14d"]
[7045.040949, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'devices.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[15;9H"]
[7045.041397, "o", "config_data = yaml.safe_load(file)\u001b[16;5H"]
[7045.041787, "o", "logger.info(\u001b(B\u001b[0;1m\u001b[32m\"Successfully loaded YAML file\"\u001b[39m\u001b(B\u001b[m)\r\u001b[17d"]
[7045.042198, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[18;5H"]
[7045.042556, "o", "logger.error(f\u001b(B\u001b[0;1m\u001b[32m\"Failed to load YAML file: {str(e)}\"\u001b[39m\u001b(B\u001b[m)\u001b[19;5H"]
[7045.042933, "o", "exit(1)\r\u001b[21d"]
[7045.043303, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up Jinja2 environment\r\u001b[22d"]
[7045.043686, "o", "\u001b[39m\u001b(B\u001b[menv = jinja2.Environment(loader=jinja2.FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[23d"]
[7045.044039, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[25d"]
[7045.04447, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure each device\r\u001b[26d"]
[7045.044878, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device_name, device_info \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m config_data[\u001b(B\u001b[0;1m\u001b[32m'devices'\u001b[39m\u001b(B\u001b[m].items():\u001b[27;5H"]
[7045.045327, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[28d\b"]
[7045.045717, "o", "\u001b(B\u001b[0;1m\u001b[31m # Render configuration using Jinja2\u001b[29;9H"]
[7045.046128, "o", "\u001b[39m\u001b(B\u001b[mconfig = template.render(device=device_info)\u001b[30;9H"]
[7045.046516, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Generated configuration for {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[32;8H"]
[7045.046944, "o", "\u001b(B\u001b[0;1m\u001b[31m # Netmiko connection\u001b[33;9H"]
[7045.047327, "o", "\u001b[39m\u001b(B\u001b[mconnection = ConnectHandler(\u001b[34;13H"]
[7045.0477, "o", "device_type=device_info[\u001b(B\u001b[0;1m\u001b[32m'device_type'\u001b[39m\u001b(B\u001b[m],\u001b[35;13H"]
[7045.04805, "o", "host=device_info[\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m],\u001b[36;13H"]
[7045.048459, "o", "username=device_info[\u001b(B\u001b[0;1m\u001b[32m'username'\u001b[39m\u001b(B\u001b[m],\u001b[37;13H"]
[7045.048855, "o", "password=device_info[\u001b(B\u001b[0;1m\u001b[32m'password'\u001b[39m\u001b(B\u001b[m]\u001b[38;9H"]
[7045.049289, "o", ")\u001b[39d\b"]
[7045.049719, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Connected to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[41;8H"]
[7045.050113, "o", "\u001b(B\u001b[0;1m\u001b[31m # Send configuration commands\u001b[42;9H"]
[7045.050496, "o", "\u001b[39m\u001b(B\u001b[mconnection.send_config_set(config.splitlines())\u001b[43;9H"]
[7045.050925, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration pushed to {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[45;8H"]
[7045.051377, "o", "\u001b(B\u001b[0;1m\u001b[31m # Save configuration\u001b[46;9H"]
[7045.051607, "o", "\u001b[39m\u001b(B\u001b[mconnection.send_command(\u001b(B\u001b[0;1m\u001b[32m'write memory'\u001b[39m\u001b(B\u001b[m)\u001b[47;9H"]
[7045.051826, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configuration saved on {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[49;8H"]
[7045.052122, "o", "\u001b(B\u001b[0;1m\u001b[31m # Disconnect\u001b[50;9H"]
[7045.052773, "o", "\u001b[39m\u001b(B\u001b[mconnection.disconnect()\u001b[51;9H"]
[7045.053051, "o", "logger.info(f\u001b(B\u001b[0;1m\u001b[32m\"Disconnected from {device_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[53;5H"]
