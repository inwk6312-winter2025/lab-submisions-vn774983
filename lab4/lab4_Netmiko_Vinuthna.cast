[8159.81617, "o", "\u001b[39m\u001b(B\u001b[mlogger.debug(f\u001b(B\u001b[0;1m\u001b[32m\"Sending command '{command}' to {device_data['name']}\"\u001b[39m\u001b(B\u001b[m)\u001b[31;25H"]
