[4433.11317, "o", "]\u001b[29d\b"]
[4433.113585, "o", "\u001b(B\u001b[0;1m\u001b[31m# Loop through each device\r\u001b[30d"]
[4433.114013, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m device \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m devices:\u001b[31;5H"]
[4433.114409, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Connecting to {device['ip']}...\\n\"\u001b[39m\u001b(B\u001b[m)\u001b[32;5H"]
[4433.114831, "o", "net_connect = Netmiko(**device)\r\u001b[33d"]
[4433.115214, "o", "\u001b[42m    \u001b[34d\b"]
[4433.115633, "o", "\u001b(B\u001b[0;1m\u001b[31m # Get parsed output of \"show ip interface brief\"\u001b[35;5H"]
[4433.116034, "o", "\u001b[39m\u001b(B\u001b[moutput = net_connect.send_command(\u001b(B\u001b[0;1m\u001b[32m\"show ip interface brief\"\u001b[39m\u001b(B\u001b[m, use_textfsm=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\u001b[36;5H"]
[4433.116624, "o", "net_connect.disconnect()\u001b[38;4H"]
[4433.11702, "o", "\u001b(B\u001b[0;1m\u001b[31m # Print interface names\u001b[39;5H"]
[4433.11748, "o", "\u001b[39m\u001b(B\u001b[mprint(f\u001b(B\u001b[0;1m\u001b[32m\"Interfaces on {device['ip']}:\"\u001b[39m\u001b(B\u001b[m)\u001b[40;5H"]
[4433.117868, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m output:\u001b[41;9H"]
[4433.118295, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\" - {interface.get('interface', 'Unknown')}\"\u001b[39m\u001b(B\u001b[m)\u001b[42;5H"]
[4433.118666, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"=\"\u001b[39m\u001b(B\u001b[m * 80)\r\u001b[43d"]
