[2832.880864, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Sending PUT to {router_ip} interface {interface_name} with IP {ip}\"\u001b[39m\u001b(B\u001b[m)\u001b[8;5H"]
