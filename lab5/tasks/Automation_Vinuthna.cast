[5308.710486, "o", "\u001b[?2004h"]
[5308.711225, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[1;58r\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[39;49m\u001b[?1h\u001b="]
[5308.711724, "o", "\u001b[?1h\u001b="]
[5308.712111, "o", "\u001b[?25l"]
[5308.713374, "o", "\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J\u001b[56;52H"]
[5308.713781, "o", "\u001b(B\u001b[0;7m[ Reading... ]"]
[5308.714195, "o", "\u001b(B\u001b[m"]
[5308.714791, "o", "\u001b[56;50H"]
[5308.715231, "o", "\u001b(B\u001b[0;7m[ Read 104 lin"]
[5308.715615, "o", "es ]"]
[5308.716019, "o", "\u001b(B\u001b[m"]
[5308.717519, "o", "\u001b[H"]
[5308.717924, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                    configure_routers.py                                              \u001b[1;115H"]
[5308.718309, "o", "\u001b(B\u001b[m"]
[5308.71905, "o", "\r\u001b[57d"]
[5308.719457, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[5308.719899, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[5308.720286, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[5308.720665, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[5308.72109, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[5308.721539, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[5308.724416, "o", "\u001b[2d"]
[5308.724841, "o", "\u001b(B\u001b[0;1m\u001b[31m# configure_routers.py\r\u001b[3d"]
[5308.725241, "o", "\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[4d"]
[5308.725663, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[5d"]
[5308.726065, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[6d"]
[5308.72649, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[7d"]
[5308.726914, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[9d"]
[5308.727338, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure logging\r\u001b[10d"]
[5308.727733, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[5308.728173, "o", "\u001b(B\u001b[0;1m\u001b[31m# --- RESTCONF Authentication and Base URL (adjust as needed) ---\r\u001b[13d"]
[5308.728549, "o", "# Assuming common credentials for all routers as per the example.\r\u001b[14d"]
[5308.72897, "o", "# In a real-world scenario, you might want to store these securely\r\u001b[15d"]
[5308.729498, "o", "# or per-router in the YAML file if they differ.\r\u001b[16d"]
[5308.729939, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[17d"]
[5308.730366, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b[31m # Assuming 'Meilab123' as per the original example\r\u001b[19d"]
[5308.730817, "o", "# --- Function to set an interface ---\r\u001b[20d"]
[5308.731213, "o", "\u001b[36mdef\u001b[34m set_interface\u001b[39m\u001b(B\u001b[m(host, user, password, interface_name, ip_address, netmask):\u001b[21;5H"]
[5308.731637, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\"\r\u001b[22d"]
[5308.732035, "o", "    Configures a single interface on a router using RESTCONF.\r\u001b[23d"]
[5308.732454, "o", "    \"\"\"\u001b[24;5H"]
[5308.732846, "o", "\u001b[39m\u001b(B\u001b[mbase_url = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(host)\u001b[25;5H"]
[5308.733287, "o", "url = base_url + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface_name\u001b[27;5H"]
[5308.733691, "o", "auth = HTTPBasicAuth(user, password)\u001b[28;5H"]
[5308.734102, "o", "headers = {\u001b[29;9H"]
