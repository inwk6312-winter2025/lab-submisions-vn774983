[2832.888054, "o", "management_ip = router_data.get(\u001b(B\u001b[0;1m\u001b[32m'management_ip'\u001b[39m\u001b(B\u001b[m)\u001b[30;9H"]
[2832.888493, "o", "interfaces = router_data.get(\u001b(B\u001b[0;1m\u001b[32m'interfaces'\u001b[39m\u001b(B\u001b[m, {})\u001b[32;9H"]
[2832.88888, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"\\nRouter: {router_name}\"\u001b[39m\u001b(B\u001b[m)\u001b[33;9H"]
