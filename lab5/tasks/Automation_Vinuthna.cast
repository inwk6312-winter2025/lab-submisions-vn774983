[6329.289411, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"router_config.yaml\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[13;5H"]
[6329.289838, "o", "config = yaml.safe_load(f)\r\u001b[15d"]
[6329.290236, "o", "\u001b(B\u001b[0;1m\u001b[31m# Authentication details\r\u001b[16d"]
[6329.290631, "o", "\u001b[39m\u001b(B\u001b[mUSERNAME = \u001b(B\u001b[0;1m\u001b[32m\"student\"\r\u001b[17d"]
