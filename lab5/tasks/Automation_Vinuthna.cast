[2832.884277, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m main\u001b[39m\u001b(B\u001b[m():\u001b[18;4H"]
[2832.884695, "o", "\u001b(B\u001b[0;1m\u001b[31m # Credentials for all routers (assuming same user/pass)\u001b[19;5H"]
[2832.885121, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\u001b[20;5H"]
[2832.885521, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b[22;4H"]
[2832.885953, "o", "\u001b[31m # Load the YAML file with router configurations\u001b[23;5H"]
[2832.886352, "o", "\u001b[39m\u001b(B\u001b[mconfig = load_config(\u001b(B\u001b[0;1m\u001b[32m'router_interfaces.yaml'\u001b[39m\u001b(B\u001b[m)\u001b[25;5H"]
[2832.886812, "o", "routers = config.get(\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m, {})\u001b[27;5H"]
[2832.887211, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Loaded Router Configurations:\"\u001b[39m\u001b(B\u001b[m)\u001b[28;5H"]
