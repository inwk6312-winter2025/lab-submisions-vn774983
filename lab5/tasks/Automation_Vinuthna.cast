[2832.892253, "o", "\u001b[36mfor\u001b[39m\u001b(B\u001b[m router_name, router_data \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m routers.items():\u001b[42;9H"]
