[4270.96244, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure logging\r\u001b[10d"]
[4270.9629, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[4270.963284, "o", "\u001b(B\u001b[0;1m\u001b[31m# --- RESTCONF Authentication and Base URL (adjust as needed) ---\r\u001b[13d"]
[4270.963672, "o", "\u001b[39m\u001b(B\u001b[m"]
[4270.964023, "o", "\u001b[?12l\u001b[?25h"]
[4270.964413, "o", "\u001b[?25l"]
[4270.987461, "o", "\u001b(B\u001b[0;1m\u001b[31m# Assuming common credentials for all routers as per the example.\r\u001b[14d"]
[4270.988083, "o", "# In a real-world scenario, you might want to store these securely\r\u001b[15d"]
[4270.988477, "o", "# or per-router in the YAML file if they differ.\r\u001b[16d"]
[4270.988916, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[17d"]
[4270.989347, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b[31m # Assuming 'Meilab123' as per the original example\r\u001b[19d"]
[4270.989738, "o", "# --- Function to set an interface ---\r\u001b[20d"]
[4270.990132, "o", "\u001b[36mdef\u001b[34m set_interface\u001b[39m\u001b(B\u001b[m(host, user, password, interface_name, ip_address, netmask):\u001b[21;5H"]
[4270.990552, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\"\r\u001b[22d"]
[4270.990989, "o", "    Configures a single interface on a router using RESTCONF.\r\u001b[23d"]
[4270.991397, "o", "    \"\"\"\u001b[24;5H"]
[4270.991796, "o", "\u001b[39m\u001b(B\u001b[mbase_url = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(host)\u001b[25;5H"]
[4270.992232, "o", "url = base_url + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface_name\u001b[27;5H"]
[4270.992652, "o", "auth = HTTPBasicAuth(user, password)\u001b[28;5H"]
[4270.993035, "o", "headers = {\u001b[29;9H"]
[4270.993424, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[30;9H"]
[4270.993848, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[31;5H"]
[4270.994256, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[33d\b"]
[4270.994671, "o", "data = {\r\u001b[34d"]
[4270.995074, "o", "\u001b[?12l\u001b[?25h"]
[4270.995461, "o", "\u001b[?25l"]
[4271.131073, "o", "\u001b[2;8H"]
[4271.131978, "o", "\u001b[1K "]
[4271.132298, "o", "response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\r\u001b[3d"]
[4271.132662, "o", "\u001b[K\u001b[4;8H"]
[4271.133042, "o", "\u001b[1K "]
[4271.133347, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[5;12H"]
[4271.133673, "o", "\u001b[1K "]
[4271.133998, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"SUCCESS: Interface {interface_name} on {host} configured. Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[6;12H"]
[4271.134296, "o", "\u001b[1K "]
[4271.135767, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[7;8H"]
[4271.136146, "o", "\u001b[39m\u001b(B\u001b[m\u001b[1K "]
[4271.136549, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[8d\b"]
[4271.137141, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"ERROR: Failed to configure {interface_name} on {host}. Code: {response.status_code}, Re\u001b[39m\u001b(B\u001b[0;7m>\u001b[9;12H"]
[4271.137534, "o", "\u001b(B\u001b[m\u001b[1K "]
[4271.137922, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[35mFalse\r\u001b[10d"]
[4271.138333, "o", "\u001b[39m\u001b(B\u001b[m    \u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m requests.exceptions.ConnectionError \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[K\u001b[11;9H"]
[4271.138714, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"CONNECTION ERROR: Could not connect to {host}. Error: {e}\"\u001b[39m\u001b(B\u001b[m)\u001b[12;8H"]
[4271.139169, "o", "\u001b[1K "]
[4271.139562, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[13d"]
[4271.139981, "o", "    \u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m Exception \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[K\u001b[14;8H"]
[4271.140352, "o", "\u001b[1K "]
[4271.140764, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"AN UNEXPECTED ERROR OCCURRED: {e}\"\u001b[39m\u001b(B\u001b[m)\u001b[K\u001b[15;8H"]
[4271.141126, "o", "\u001b[1K "]
[4271.141534, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[16d"]
[4271.141915, "o", "\u001b[K\u001b[17d"]
[4271.142326, "o", "\u001b(B\u001b[0;1m\u001b[31m# --- Main script execution ---\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[18d"]
[4271.142712, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m __name__ == \u001b(B\u001b[0;1m\u001b[32m\"__main__\"\u001b[39m\u001b(B\u001b[m:\r\u001b[19d"]
[4271.143154, "o", "    yaml_file_path = \u001b(B\u001b[0;1m\u001b[32m'router_configs.yaml'\r\u001b[20d"]
[4271.143527, "o", "\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[21;5H"]
[4271.143943, "o", "\u001b(B\u001b[0;1m\u001b[36mtry\u001b[39m\u001b(B\u001b[m:\u001b[22d\b"]
[4271.144328, "o", "\u001b[1K "]
[4271.144756, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(yaml_file_path, \u001b(B\u001b[0;1m\u001b[32m'r'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[K\u001b[23;12H"]
[4271.145134, "o", "\u001b[1K "]
[4271.145532, "o", "router_configs = yaml.safe_load(file)\u001b[24;5H"]
[4271.145916, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m FileNotFoundError:\u001b[K\u001b[25;5H"]
[4271.14621, "o", "    logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error: The YAML file '{yaml_file_path}' was not found.\"\u001b[39m\u001b(B\u001b[m)\u001b[26;9H"]
[4271.146463, "o", "exit(1)\u001b[27;5H"]
[4271.14706, "o", "\u001b(B\u001b[0;1m\u001b[36mexcept\u001b[39m\u001b(B\u001b[m yaml.YAMLError \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m e:\u001b[K\u001b[28;5H"]
[4271.14733, "o", "    logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error parsing YAML file: {e}\"\u001b[39m\u001b(B\u001b[m)\u001b[29;9H"]
[4271.147581, "o", "exit(1)\u001b[K\r\u001b[30d"]
[4271.14784, "o", "\u001b[K\u001b[31;5H"]
[4271.148126, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m router_configs \u001b(B\u001b[0;1m\u001b[36mor\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m router_configs:\u001b[32;9H"]
[4271.148395, "o", "logging.error(\u001b(B\u001b[0;1m\u001b[32m\"Error: YAML file is empty or 'routers' key is missing.\"\u001b[39m\u001b(B\u001b[m)\u001b[33;5H"]
[4271.148647, "o", "    exit(1)\u001b[35;5H"]
[4271.148935, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m router_name, config \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m router_configs[\u001b(B\u001b[0;1m\u001b[32m'routers'\u001b[39m\u001b(B\u001b[m].items():\u001b[36;9H"]
[4271.149903, "o", "host_ip = config.get(\u001b(B\u001b[0;1m\u001b[32m'management_ip'\u001b[39m\u001b(B\u001b[m)\u001b[37;9H"]
[4271.150174, "o", "interfaces = config.get(\u001b(B\u001b[0;1m\u001b[32m'interfaces'\u001b[39m\u001b(B\u001b[m, {})\u001b[39;9H"]
[4271.15043, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36mnot\u001b[39m\u001b(B\u001b[m host_ip:\u001b[40;13H"]
[4271.150725, "o", "logging.warning(f\u001b(B\u001b[0;1m\u001b[32m\"Skipping {router_name}: 'management_ip' not found.\"\u001b[39m\u001b(B\u001b[m)\u001b[41;13H"]
[4271.15113, "o", "\u001b(B\u001b[0;1m\u001b[36mcontinue\u001b[43;9H"]
[4271.151427, "o", "\u001b[39m\u001b(B\u001b[mlogging.info(f\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Attempting to configure {router_name} ({host_ip}) ---\"\u001b[39m\u001b(B\u001b[m)\u001b[45;9H"]
[4271.151857, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m interface_name, interface_details \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interfaces.items():\u001b[46;13H"]
[4271.152136, "o", "ip_address = interface_details.get(\u001b(B\u001b[0;1m\u001b[32m'ip'\u001b[39m\u001b(B\u001b[m)\u001b[47;13H"]
[4271.152503, "o", "netmask = interface_details.get(\u001b(B\u001b[0;1m\u001b[32m'netmask'\u001b[39m\u001b(B\u001b[m)\u001b[49;13H"]
[4271.15267, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m ip_address \u001b(B\u001b[0;1m\u001b[36mand\u001b[39m\u001b(B\u001b[m netmask:\u001b[50;17H"]
[4271.152873, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"  - Configuring {interface_name} with IP {ip_address}/{netmask}...\"\u001b[39m\u001b(B\u001b[m)\u001b[51;17H"]
[4271.153043, "o", "set_interface(host_ip, USER, PASS, interface_name, ip_address, netmask)\u001b[52;13H"]
[4271.153292, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[53d\b"]
[4271.153466, "o", "logging.warning(f\u001b(B\u001b[0;1m\u001b[32m\"  - Skipping {interface_name} on {router_name}: Missing 'ip' or 'netmask'.\"\u001b[39m\u001b(B\u001b[m)\u001b[55;5H"]
[4271.153727, "o", "logging.info(\u001b(B\u001b[0;1m\u001b[32m\"\\n--- Configuration process complete. ---\"\u001b[39m\u001b(B\u001b[m)"]
[4271.154001, "o", "\u001b[?12l\u001b[?25h"]
[4272.429181, "o", "\u001b[?25l\r\u001b[56d"]
