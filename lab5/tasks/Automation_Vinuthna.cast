[6329.288138, "o", "\u001b(B\u001b[0;1m\u001b[31m# Set up logging\r\u001b[9d"]
[6329.288551, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
