[6154.109718, "o", "\u001b(B\u001b[m"]
[6154.11056, "o", "\r\u001b[57d"]
[6154.11107, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[6154.111449, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[6154.111786, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[6154.112177, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[6154.112514, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[6154.112906, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[6154.115406, "o", "\u001b[2d"]
[6154.115798, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[3d"]
[6154.116163, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[6154.116579, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[6154.116964, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[6d"]
[6154.11738, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[7d"]
[6154.117773, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m urllib.parse\u001b(B\u001b[0;1m\u001b[31m # Import for URL encoding\r\u001b[9d"]
[6154.118182, "o", "# Configure logging\r\u001b[10d"]
[6154.118574, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[6154.11902, "o", "USER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[13d"]
[6154.119413, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[15d"]
[6154.119834, "o", "\u001b[31m# --- Function to set an interface ---\r\u001b[16d"]
[6154.120247, "o", "\u001b[36mdef\u001b[34m set_interface\u001b[39m\u001b(B\u001b[m(host, user, password, interface_name, ip_address, netmask):\u001b[17;5H"]
[6154.120653, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\"\r\u001b[18d"]
[6154.121037, "o", "    Configures a single interface on a router using RESTCONF.\r\u001b[19d"]
[6154.121443, "o", "    \"\"\"\u001b[20;4H"]
[6154.121798, "o", "\u001b[31m # Option 1: Try the original BASE_URL and URL-encode the interface name\u001b[21;4H"]
[6154.122175, "o", " # url_encoded_interface_name = urllib.parse.quote(interface_name, safe='')\u001b[22;4H"]
[6154.122495, "o", " # base_url = 'http://{0}/restconf/api/running/'.format(host)\u001b[23;4H"]
[6154.122903, "o", " # url = base_url + \"interfaces/interface/\" + url_encoded_interface_name\u001b[25;4H"]
[6154.123252, "o", " # Option 2: A common alternative base path for data manipulation\u001b[26;4H"]
[6154.123612, "o", " # This path is often used for configuration data.\u001b[27;5H"]
[6154.123993, "o", "\u001b[39m\u001b(B\u001b[mbase_url = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/data/'\u001b[39m\u001b(B\u001b[m.format(host)\u001b[28;5H"]
[6154.124364, "o", "url_encoded_interface_name = urllib.parse.quote(interface_name, safe=\u001b(B\u001b[0;1m\u001b[32m''\u001b[39m\u001b(B\u001b[m)\u001b[29;5H"]
[6154.124713, "o", "url = base_url + f\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interfaces/interface={url_encoded_interface_name}\"\u001b[32;5H"]
[6154.125077, "o", "\u001b[39m\u001b(B\u001b[mauth = HTTPBasicAuth(user, password)\u001b[33;5H"]
[6154.125429, "o", "headers = {\u001b[34;9H"]
[6154.125845, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/yang-data+json'\u001b[39m\u001b(B\u001b[m,\u001b(B\u001b[0;1m\u001b[31m # Changed from vnd.yang.data+json - often works better\u001b[35;9H"]
[6154.126248, "o", "\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/yang-data+json'\u001b[31m # Changed from vnd.yang.data+json\u001b[36;5H"]
[6154.126671, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[38d\b"]
[6154.127074, "o", "data = {\u001b[39;9H"]
[6154.127498, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: [\u001b(B\u001b[0;1m\u001b[31m # Changed to a list, as some APIs expect interface objects in a list\u001b[40;13H"]
[6154.127883, "o", "\u001b[39m\u001b(B\u001b[m{\u001b[41;17H"]
[6154.128285, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface_name,\u001b[42;17H"]
[6154.128666, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: f\u001b(B\u001b[0;1m\u001b[32m\"Configured by script - {interface_name}\"\u001b[39m\u001b(B\u001b[m,\u001b[43;17H"]
[6154.129103, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[44;17H"]
[6154.129363, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[45;17H"]
[6154.129615, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[46;21H"]
[6154.130221, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[47;25H"]
[6154.13049, "o", "{\u001b[48;29H"]
[6154.130752, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: ip_address,\u001b[49;29H"]
[6154.131064, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: netmask\u001b[50;25H"]
[6154.131315, "o", "}\u001b[51;21H"]
[6154.131583, "o", "]\u001b[52;17H"]
[6154.13183, "o", "},\u001b[53d\b\b"]
