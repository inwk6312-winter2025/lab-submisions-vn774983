[5399.806508, "o", "\u001b(B\u001b[m"]
[5399.807165, "o", "\r\u001b[57d"]
[5399.807585, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help     \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out    \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[81G"]
[5399.808013, "o", "\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos\u001b[97G"]
[5399.80843, "o", "\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[58d"]
[5399.80882, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[58;17H"]
[5399.809246, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File    \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[49G"]
[5399.809655, "o", "\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text   \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell     \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line   \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[56d"]
[5399.812047, "o", "\u001b[2d"]
[5399.812464, "o", "\u001b(B\u001b[0;1m\u001b[31m# configure_routers.py\r\u001b[3d"]
[5399.812869, "o", "\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[4d"]
[5399.813302, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[5d"]
[5399.813701, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[6d"]
[5399.814143, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[7d"]
[5399.814532, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[9d"]
[5399.814982, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure logging\r\u001b[10d"]
[5399.815395, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[12d"]
[5399.81583, "o", "\u001b(B\u001b[0;1m\u001b[31m# --- RESTCONF Authentication and Base URL (adjust as needed) ---\r\u001b[13d"]
[5399.816224, "o", "# Assuming common credentials for all routers as per the example.\r\u001b[14d"]
[5399.816682, "o", "# In a real-world scenario, you might want to store these securely\r\u001b[15d"]
[5399.817073, "o", "# or per-router in the YAML file if they differ.\r\u001b[16d"]
[5399.817496, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[17d"]
[5399.817891, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b[31m # Assuming 'Meilab123' as per the original example\r\u001b[19d"]
[5399.818323, "o", "# --- Function to set an interface ---\r\u001b[20d"]
[5399.818711, "o", "\u001b[36mdef\u001b[34m set_interface\u001b[39m\u001b(B\u001b[m(host, user, password, interface_name, ip_address, netmask):\u001b[21;5H"]
[5399.81915, "o", "\u001b(B\u001b[0;1m\u001b[32m\"\"\"\r\u001b[22d"]
[5399.819535, "o", "    Configures a single interface on a router using RESTCONF.\r\u001b[23d"]
[5399.819957, "o", "    \"\"\"\u001b[24;5H"]
[5399.820384, "o", "\u001b[39m\u001b(B\u001b[mbase_url = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(host)\u001b[25;5H"]
[5399.820822, "o", "url = base_url + \u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m + interface_name\u001b[27;5H"]
[5399.821225, "o", "auth = HTTPBasicAuth(user, password)\u001b[28;5H"]
[5399.821639, "o", "headers = {\u001b[29;9H"]
[5399.822065, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[30;9H"]
[5399.822464, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[31;5H"]
[5399.822883, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[33d\b"]
[5399.823311, "o", "data = {\u001b[34;9H"]
[5399.823696, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[35;13H"]
[5399.824122, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface_name,\u001b[36;13H"]
[5399.824515, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: f\u001b(B\u001b[0;1m\u001b[32m\"Configured by script - {interface_name}\"\u001b[39m\u001b(B\u001b[m,\u001b[37;13H"]
[5399.824937, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[38;13H"]
[5399.825329, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[31m # Use boolean True for enabled\u001b[39;13H"]
[5399.82575, "o", "\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[40;17H"]
[5399.826129, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[41;21H"]
[5399.826569, "o", "{\u001b[42;25H"]
[5399.826881, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: ip_address,\u001b[43;25H"]
[5399.827169, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: netmask\u001b[44;21H"]
[5399.827761, "o", "}\u001b[45;7H"]
