[6329.301854, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[47;9H"]
[6329.302162, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Configured {interface['name']} on {host} successfully.\"\u001b[39m\u001b(B\u001b[m)\u001b[48;5H"]
