[6329.292344, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\r\u001b[21d"]
[6329.292772, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[23d\b"]
[6329.293163, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m configure_interface\u001b[39m\u001b(B\u001b[m(host, interface):\u001b[24;5H"]
[6329.293571, "o", "url = f\u001b(B\u001b[0;1m\u001b[32m\"http://{host}/restconf/api/running/interfaces/interface/{interface['name']}\"\u001b[25;5H"]
[6329.293971, "o", "\u001b[39m\u001b(B\u001b[mdata = {\u001b[26;9H"]
[6329.29436, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[27;13H"]
[6329.294813, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface[\u001b(B\u001b[0;1m\u001b[32m'name'\u001b[39m\u001b(B\u001b[m],\u001b[28;13H"]
[6329.29528, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Configured by RESTCONF script\"\u001b[39m\u001b(B\u001b[m,\u001b[29;13H"]
[6329.295681, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[30;13H"]
[6329.296078, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\u001b[31;13H"]
[6329.296497, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[32;17H"]
[6329.296882, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[33;21H"]
[6329.297326, "o", "{\u001b[34;25H"]
