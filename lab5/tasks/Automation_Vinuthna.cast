[3408.627423, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m load_config\u001b[39m\u001b(B\u001b[m(file_path):\u001b[11;5H"]
[3408.627777, "o", "\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m'router_interfaces.yaml'\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m'w'\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[12;9H"]
